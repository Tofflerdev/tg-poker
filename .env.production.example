# ============================================
# Production .env template — copy to .env ON THE BOX and fill in.
#
# TWO BOXES RUN THIS REPO: the live one and the test stand. They share the code
# and the compose file, and differ only here. So:
#
#   - NEVER copy a .env from the other box. Secrets are per-box; on the stand
#     ADMIN_PASS and POSTGRES_PASSWORD happen to be identical, and copying that
#     file moves the coincidence somewhere it costs real money.
#   - Generate every secret separately:
#       node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# `.env.example` is the annotated reference for every key the code reads,
# including the ones left out here. This file is the shape a production box
# actually needs.
#
# ⚠️ compose passes env to the container by EXPLICIT LIST. A key added here and
# not added to `environment:` in docker-compose.prod.yml never reaches the app,
# however neatly it sits in .env. This has bitten the project three times.
# ============================================

# --- Database ---------------------------------------------------------------
POSTGRES_USER=poker
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=poker_db

# --- This box ---------------------------------------------------------------
# Public domain of THIS box. Required: nginx renders its config from
# nginx/default.conf.template at start-up and needs it for server_name and the
# Let's Encrypt paths. Compose refuses to start when it is empty.
DOMAIN=CHANGE_ME
NODE_ENV=production
PORT=3000

# --- Telegram ---------------------------------------------------------------
# The bot the Mini App is served from. BOT_TOKEN carries the HMAC that validates
# initData: a token from a different bot means nobody can log in at all, so the
# bot and its token always change together.
BOT_TOKEN=CHANGE_ME
# Used for the "back to the app" button CryptoBot shows after a paid invoice.
BOT_USERNAME=CHANGE_ME

# --- Admin panel ------------------------------------------------------------
# Empty JWT_SECRET with NODE_ENV=production exits at boot with code 1, by design.
JWT_SECRET=CHANGE_ME
ADMIN_USER=admin
# Generate separately from POSTGRES_PASSWORD. They are not the same secret and
# must not share a value.
ADMIN_PASS=CHANGE_ME

# --- Error tracking ---------------------------------------------------------
# ⚠️ SILENT IF EMPTY: Sentry.init is skipped and the money-invariant alert
# reaches nothing but the container log. The app boots perfectly either way.
SENTRY_DSN=CHANGE_ME
# `production` on the live box, `staging` on the stand — the alert rule fires on
# production only. NOT derived from NODE_ENV, which is production on both.
SENTRY_ENVIRONMENT=production

# --- Crypto Pay -------------------------------------------------------------
# ⚠️ SILENT IF EMPTY: deposits are simply disabled and the app looks healthy.
# Check the boot log for the app name — it is the proof the right token is in.
CRYPTO_PAY_TOKEN=CHANGE_ME
# false = mainnet (real money). true = testnet.
CRYPTO_PAY_TESTNET=false

# --- Money invariant --------------------------------------------------------
# Pre-ledger residue the invariant must forgive. 0 on a database that starts
# clean; a drift that is not this constant is a bug worth waking up for.
MONEY_INVARIANT_BASELINE_CHIPS=0

# --- Withdrawal policy ------------------------------------------------------
# All optional; code defaults apply when unset (min $10, max $25000 per request,
# $500 per rolling 24h). Tune without a deploy — a restart picks them up.
# Leave WITHDRAWAL_MIN_HANDS unset: dropped 2026-08-05, see .env.example.
# WITHDRAWAL_MIN_CHIPS=1000
# WITHDRAWAL_MAX_CHIPS=2500000
# WITHDRAWAL_DAILY_LIMIT_CHIPS=50000

# --- Backups ----------------------------------------------------------------
# Read by backup.sh on the HOST (cron), never by a container.
# age PUBLIC key; the private half lives with the owner, off this server.
BACKUP_AGE_RECIPIENT=CHANGE_ME
# Owner's Telegram chat id — daily dump + every failure alert. Empty = silent.
BACKUP_TG_CHAT_ID=CHANGE_ME
# ⚠️ MUST DIFFER PER BOX. Both boxes name dumps db-YYYYMMDD-HHMM.dump.age and
# both run cron at :17, so a shared prefix makes the names collide and one box
# overwrites the other's backups. Use b2:tgp-backups/prod and .../staging.
BACKUP_REMOTE=b2:tgp-backups/prod
