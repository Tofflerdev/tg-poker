# Database
DATABASE_URL=postgresql://poker:poker@localhost:5432/poker_db

# Telegram
BOT_TOKEN=your_bot_token_here

# Server
NODE_ENV=development
PORT=3000

# Enables the dev-only auth bypass. MUST be unset or false in production.
# ALLOW_DEV_AUTH=false

# === Observability (Phase 5 / Plan 05-02) — both optional, graceful no-op if absent ===

# Sentry server DSN. Leave empty in dev; set in prod for error tracking.
# SENTRY_DSN=https://...@sentry.io/...

# Which STAND the events come from — `production` on the live box, `staging` on
# a test one, so one Sentry project can hold both and alert rules can fire for
# production only. Not derived from NODE_ENV: a staging box runs
# NODE_ENV=production too, and would otherwise be indistinguishable.
# Falls back to NODE_ENV when empty.
# SENTRY_ENVIRONMENT=production

# SENTRY_RELEASE is not set by hand — update.sh exports the deployed commit sha.

# PostHog server API key. Leave empty in dev; set in prod for analytics.
# POSTHOG_API_KEY=phc_...
# POSTHOG_HOST=https://app.posthog.com  # override only for self-hosted PostHog

# === Admin Panel (Phase 5 / Plan 05-03) ===

# JWT_SECRET — required for production. Booting NODE_ENV=production with this empty exits with code 1.
# Dev fallback is an ephemeral process-local secret (warn logged once).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# JWT_SECRET=

# Admin username and password. Single admin user only — multi-admin is v1.1+.
# Required for the admin panel login at /admin (lazy-loaded SPA).
# ADMIN_USER=admin
# ADMIN_PASS=change-me-in-prod

# === Crypto Pay deposits (crypto-payments-rake phase 4 §D) ===

# Crypto Pay app token from @CryptoBot. When empty, deposits are disabled
# (dev/play-money still works). The webhook lives at POST /api/crypto/webhook.
# CRYPTO_PAY_TOKEN=

# Set to true to hit the Crypto Pay testnet (https://testnet-pay.crypt.bot/api).
# CRYPTO_PAY_TESTNET=false

# "Back to the app" button shown by CryptoBot after an invoice is paid. Set the
# bot username (with or without @) — the link https://t.me/<username> is built
# from it. CHANGE THIS WHEN THE PRODUCTION BOT REPLACES THE TEST ONE.
# BOT_USERNAME=Testpoke_bot

# Optional override for the line above when a plain bot link is not enough,
# e.g. a deep link straight into the mini app. Wins over BOT_USERNAME.
# MINI_APP_URL=https://t.me/Testpoke_bot/app?startapp=deposit

# === Withdrawal policy (crypto-payments-rake phase 5 §I) ===
# Anti-transit limits instead of documentary KYC. All optional — the defaults
# below apply when unset. Tune without a deploy; a restart picks them up.

# Smallest payout in chips (1 chip = $0.01). Default 1000 = $10.
# WITHDRAWAL_MIN_CHIPS=1000

# Largest single payout. Crypto Pay caps one `transfer` near $25000, so keep this
# at or below 2500000 chips or the provider rejects it. Default 2500000.
# WITHDRAWAL_MAX_CHIPS=2500000

# Rolling 24h payout cap per player. Default 50000 chips = $500.
# WITHDRAWAL_DAILY_LIMIT_CHIPS=50000

# Hands required since the player's last deposit before they may cash out — the
# anti-transit threshold. Plan value is 50. DEFAULT IS 0 (testnet, so the payout
# path can be exercised without grinding hands). SET THIS TO 50 BEFORE LAUNCH.
# WITHDRAWAL_MIN_HANDS=50

# === Money invariant (crypto-payments-rake phase 6) ===

# deposits − withdrawals must equal Σ balances + chips on tables + this baseline.
# The baseline covers pre-ledger history: on prod, balances were wiped by hand
# twice (§G cleanup + the bot clean-up of 2026-07-23) without matching ledger
# rows, leaving 970 + 194 = 1164 chips of history with no balance behind them.
# Leave it 0 on a clean database. A drift that is not this constant is a bug.
# MONEY_INVARIANT_BASELINE_CHIPS=1164

# Admin-queue flag thresholds (advisory only, never block): flag a payout that
# takes >= N% of everything the player deposited while they have played fewer
# than M hands since that deposit.
# WITHDRAWAL_FLAG_RATIO_PCT=90
# WITHDRAWAL_FLAG_HANDS_BELOW=100

# === Postgres backups (plans/db-backup-plan.md) ===
# Read by backup.sh, which runs on the HOST from cron — these never reach a
# container, so there is nothing to add to docker-compose.prod.yml.

# age PUBLIC key (recipient). The matching private key lives with the owner,
# OFF this server: whoever steals the box gets unreadable dumps. Generated once
# with `age-keygen -o tgp-backup.key` — the "Public key: age1..." line goes here.
# BACKUP_AGE_RECIPIENT=age1...

# Owner's Telegram chat id: gets the daily encrypted dump as a document and
# every failure alert. Empty = backups still run, but silently.
# BACKUP_TG_CHAT_ID=

# rclone remote + bucket. Backblaze B2 (10 GB free, no card at signup).
# B2 bucket names are globally unique, so the plain name may be taken — whatever
# you called it goes here. Default b2:tgp-backups.
# BACKUP_REMOTE=b2:tgp-backups

# Hour (UTC) whose run also writes daily/ and DMs the file. Default 03.
# BACKUP_DAILY_HOUR_UTC=03

# How long encrypted dumps stay on the server's own disk. Default 48.
# BACKUP_LOCAL_RETENTION_HOURS=48

# Retention on the remote, applied by the script itself (not by bucket lifecycle
# rules — one less thing living in a web UI). Defaults 7 and 90 days.
# BACKUP_REMOTE_HOURLY_DAYS=7
# BACKUP_REMOTE_DAILY_DAYS=90

# === Playtest bots (server/bot/) ===

# When truthy, the SessionRecorder appends every action + hand result to
# sessions/<ts>.jsonl for offline oracle/analysis. Leave unset in normal runs.
# RECORD_SESSIONS=1
