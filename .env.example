# Database
DATABASE_URL=postgresql://poker:poker@localhost:5432/poker_db

# Telegram
BOT_TOKEN=your_bot_token_here

# Server
NODE_ENV=development
PORT=3000

# Enables the dev-only auth bypass. MUST be unset or false in production.
# ALLOW_DEV_AUTH=false

# === Observability (Phase 5 / Plan 05-02) — both optional, graceful no-op if absent ===

# Sentry server DSN. Leave empty in dev; set in prod for error tracking.
# SENTRY_DSN=https://...@sentry.io/...

# PostHog server API key. Leave empty in dev; set in prod for analytics.
# POSTHOG_API_KEY=phc_...
# POSTHOG_HOST=https://app.posthog.com  # override only for self-hosted PostHog

# === Admin Panel (Phase 5 / Plan 05-03) ===

# JWT_SECRET — required for production. Booting NODE_ENV=production with this empty exits with code 1.
# Dev fallback is an ephemeral process-local secret (warn logged once).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# JWT_SECRET=

# Admin username and password. Single admin user only — multi-admin is v1.1+.
# Required for the admin panel login at /admin (lazy-loaded SPA).
# ADMIN_USER=admin
# ADMIN_PASS=change-me-in-prod

# === Crypto Pay deposits (crypto-payments-rake phase 4 §D) ===

# Crypto Pay app token from @CryptoBot. When empty, deposits are disabled
# (dev/play-money still works). The webhook lives at POST /api/crypto/webhook.
# CRYPTO_PAY_TOKEN=

# Set to true to hit the Crypto Pay testnet (https://testnet-pay.crypt.bot/api).
# CRYPTO_PAY_TESTNET=false

# === Withdrawal policy (crypto-payments-rake phase 5 §I) ===
# Anti-transit limits instead of documentary KYC. All optional — the defaults
# below apply when unset. Tune without a deploy; a restart picks them up.

# Smallest payout in chips (1 chip = $0.01). Default 1000 = $10.
# WITHDRAWAL_MIN_CHIPS=1000

# Largest single payout. Crypto Pay caps one `transfer` near $25000, so keep this
# at or below 2500000 chips or the provider rejects it. Default 2500000.
# WITHDRAWAL_MAX_CHIPS=2500000

# Rolling 24h payout cap per player. Default 50000 chips = $500.
# WITHDRAWAL_DAILY_LIMIT_CHIPS=50000

# Hands required since the player's last deposit before they may cash out — the
# anti-transit threshold. Plan value is 50. DEFAULT IS 0 (testnet, so the payout
# path can be exercised without grinding hands). SET THIS TO 50 BEFORE LAUNCH.
# WITHDRAWAL_MIN_HANDS=50

# Admin-queue flag thresholds (advisory only, never block): flag a payout that
# takes >= N% of everything the player deposited while they have played fewer
# than M hands since that deposit.
# WITHDRAWAL_FLAG_RATIO_PCT=90
# WITHDRAWAL_FLAG_HANDS_BELOW=100

# === Playtest bots (server/bot/) ===

# When truthy, the SessionRecorder appends every action + hand result to
# sessions/<ts>.jsonl for offline oracle/analysis. Leave unset in normal runs.
# RECORD_SESSIONS=1
