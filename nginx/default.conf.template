# TEMPLATE — not a ready config. The nginx:alpine entrypoint runs envsubst over
# /etc/nginx/templates/*.template on every container start and writes the result
# to /etc/nginx/conf.d/. ${DOMAIN} is the only thing substituted, pinned by
# NGINX_ENVSUBST_FILTER=DOMAIN in compose; nginx's own $host / $uri /
# $remote_addr are not environment variables and are left alone.
#
# Two boxes (live + test stand) run this same file from the same main on
# different domains, which is why the name is not hardcoded any more.
#
# To read the config that is ACTUALLY serving:
#   docker compose -f docker-compose.prod.yml exec nginx cat /etc/nginx/conf.d/default.conf

upstream app_server {
    server app:3000;
}

server {
    listen 80;
    server_name ${DOMAIN};

    # Redirect HTTP to HTTPS
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    server_name ${DOMAIN};

    # SSL certificates (Let's Encrypt) — the path carries the domain name, so it
    # gets templated as well.
    ssl_certificate /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;

    # SSL settings
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;

    # HSTS
    add_header Strict-Transport-Security "max-age=63072000" always;

    # Gzip compression
    gzip on;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml text/javascript image/svg+xml;
    gzip_min_length 256;

    # Serve static client files
    root /usr/share/nginx/html;
    index index.html;

    # Static assets with cache
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # index.html must NEVER be cached. It is the only file that names the hashed
    # bundles, and /assets/ above is immutable for a year — so a stale index pins the
    # entire old app. With no Cache-Control at all (the previous state) a client is
    # free to apply heuristic freshness off Last-Modified, and Telegram's WebView does
    # exactly that: a deployed fix could keep not showing up for hours.
    # add_header does not inherit into a location, so HSTS is repeated here.
    location = /index.html {
        add_header Strict-Transport-Security "max-age=63072000" always;
        add_header Cache-Control "no-cache, must-revalidate" always;
        try_files $uri =404;
    }

    # Socket.IO WebSocket + polling
    location /socket.io/ {
        proxy_pass http://app_server;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # WebSocket timeouts
        proxy_read_timeout 86400s;
        proxy_send_timeout 86400s;
    }

    # API endpoints
    location /api/ {
        proxy_pass http://app_server;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Health check endpoint
    location = /health {
        proxy_pass http://app_server/;
        proxy_set_header Host $host;
    }

    # SPA fallback — all other routes serve index.html
    location / {
        try_files $uri $uri/ /index.html;
    }
}
